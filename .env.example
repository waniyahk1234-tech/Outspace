# Runtime / AI Studio Env
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
SESSION_SECRET="outspace-dev-session-secret-change-in-prod"

# MongoDB Database (MongoDB Atlas or local MongoDB)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="outspace"

# Google (Gmail) Login works via Firebase Authentication (firebase-applet-config.json).
# Optional on Vercel: set VITE_FIREBASE_AUTH_DOMAIN to your Vercel domain (e.g. your-app.vercel.app)
# after adding https://<your-domain>/__/auth/handler to your OAuth client redirect URIs for first-party mobile redirects.
VITE_FIREBASE_AUTH_DOMAIN=""
FIREBASE_WEB_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn OAuth Login (OpenID Connect: openid, profile, email)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Email Verification Delivery (Gmail SMTP with App Password or custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Outspace Pakistan <noreply@outspace.pk>"

# Optional Supabase (for Postgres/Supabase deployment using supabase/schema.sql & supabase/seed.sql)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
